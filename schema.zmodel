/// A sample data source using local sqlite db.
datasource db {
    provider = 'postgresql'
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SURVEYOR
  SUPERADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum CampaignPhase {
  PRE
  MID
  POST
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SURVEYOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id String @id @default(uuid())
  title String
  description String?
  activePhase CampaignPhase @default(PRE)
  status  CampaignStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surveys Survey[]
  // reports AiReport[]
}

model Survey {
  id String @id @default(uuid())
  campaignId String
  title String
  form String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phase CampaignPhase @default(PRE)
  isFinalized Boolean @default(false)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responses Response[]
}

model Response {
  id String @id @default(uuid())
  surveyId String
  name String
  address String
  phone String
  valid_id String
  data String // Answers in JSON format
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}


/// A sample data source using local sqlite db.
datasource db {
    provider = 'postgresql'
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SURVEYOR
  SUPERADMIN
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum CampaignPhase {
  PRE
  MID
  POST
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SURVEYOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign {
  id String @id @default(uuid())
  title String
  description String?
  activePhase CampaignPhase @default(PRE)
  status  CampaignStatus @default(DRAFT)
  candidateName String @default("")
  candidatePosition String @default("")
  candidateParty String @default("")
  fbUrl String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surveys Survey[]
  reports AiReport[]
  facebookPosts FacebookPost[]
}

model Survey {
  id String @id @default(uuid())
  campaignId String
  title String
  form String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  phase CampaignPhase @default(PRE)
  isFinalized Boolean @default(false)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  responses Response[]
}

model Response {
  id String @id @default(uuid())
  surveyId String
  name String
  address String
  phone String
  valid_id String
  data String // Answers in JSON format
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model AiReport {
  id String @id @default(uuid())
  campaignId String
  phase CampaignPhase
  report Json // AI-generated report content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model HistoryData {
  id String @id @default(uuid())
  year String
  position String
  json Json
  createdAt DateTime @default(now())

  @@unique([year, position])
}

model FacebookPost {
  id            String         @id @default(uuid())
  campaignId    String
  phase         CampaignPhase  // Link post data to a specific campaign phase
  content       String?
  url           String         // URL to the Facebook post
  timestamp     DateTime
  likes         Int            @default(0)
  shares        Int            @default(0)
  commentsCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  facebookComments FacebookComment[]

  @@unique([campaignId, phase, url])
}

model FacebookComment {
  id            String    @id @default(uuid())
  postId        String
  phase         CampaignPhase  // Link comment data to a specific campaign phase
  content       String?
  authorName    String?
  timestamp     DateTime
  url           String
  likes         Int       @default(0)
  replies       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  post          FacebookPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, phase, url])
}


